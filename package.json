{
  "name": "virtuoso-source-tools",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:core": "node scripts/lint.mjs --core",
    "typecheck": "tsc --project tsconfig.core.json && tsc --project tsconfig.shell.json",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:brand": "node scripts/check-brand-hygiene.mjs",
    "deadcode": "knip --config knip.json --no-progress",
    "deadcode:production": "knip --config knip.json --no-progress --production"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "eslint": "10.6.0",
    "globals": "17.11.0",
    "knip": "6.42.1",
    "typescript": "5.9.3"
  }
}

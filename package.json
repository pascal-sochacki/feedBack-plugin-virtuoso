{
  "name": "virtuoso-source-tools",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.mjs",
    "lint": "eslint --config eslint.config.mjs screen.js 'src/**/*.js' 'tests/**/*.mjs'",
    "lint:core": "eslint --config eslint.config.mjs 'src/**/*.js'",
    "typecheck": "tsc --project tsconfig.core.json && tsc --project tsconfig.shell.json && tsc --project tsconfig.renderer.json",
    "check:precommit": "npm run check:quality && npm test && npm run deadcode && npm run deadcode:production",
    "check:quality": "npm run lint && npm run typecheck",
    "deadcode": "knip --config knip.json --no-progress",
    "deadcode:production": "knip --config knip.json --no-progress --production",
    "generate:practices": "node scripts/generate-practice-index.mjs && node scripts/generate-practice-blocks.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "eslint": "10.6.0",
    "globals": "17.11.0",
    "knip": "6.42.1",
    "typescript": "5.9.3"
  }
}

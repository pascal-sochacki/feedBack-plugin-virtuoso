{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "screen.js!",
        "scripts/check-brand-hygiene.mjs",
        "scripts/check-doc-links.mjs",
        "scripts/cut-beta.mjs",
        "scripts/cut-lab.mjs",
        "scripts/lint.mjs",
        "tests/*.mjs"
      ],
      "project": ["scripts/*.mjs", "tests/**/*.mjs"],
      "eslint": { "config": ["eslint.config.mjs"] }
    },
    "src": {
      "entry": [],
      "project": ["**/*.js!"]
    }
  }
}
